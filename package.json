{
  "name": "opennews",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test src/lib/*.test.ts",
    "android:sync": "npm run build && npx cap sync android && bash native/android/sync-plugins.sh && bash native/android/sync-icons.sh",
    "android:release": "bash native/android/build-release.sh",
    "push:worker": "tsx scripts/push-news.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-xml-parser": "^5.12.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.78.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  },
  "description": "Datenschutzfreundliche Nachrichten-App für Web und Android",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixxermannipro/OpenNews.git"
  },
  "author": "mixxermannipro",
  "license": "UNLICENSED"
}
