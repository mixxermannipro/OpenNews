<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="5dp"
    android:background="@drawable/opennews_widget_card_light">

    <ImageView
        android:id="@+id/widget_article_hero"
        android:layout_width="match_parent" android:layout_height="104dp"
        android:layout_marginBottom="4dp" android:scaleType="centerCrop"
        android:background="@drawable/opennews_widget_photo" android:clipToOutline="true"
        android:importantForAccessibility="no" android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_article_thumb"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="2dp" android:layout_marginEnd="4dp"
            android:scaleType="centerCrop" android:background="@drawable/opennews_widget_photo"
            android:clipToOutline="true" android:importantForAccessibility="no" android:visibility="gone" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="3dp" android:paddingEnd="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_article_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:ellipsize="end" android:maxLines="2" />
            <TextView
                android:id="@+id/widget_article_meta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:ellipsize="end" android:maxLines="1" />
            <TextView
                android:id="@+id/widget_article_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textSize="13sp"
                android:ellipsize="end" android:maxLines="2" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_article_save" style="@style/OpenNewsWidgetIcon"
            android:src="@drawable/widget_bookmark" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
