<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/opennews_widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:background="@drawable/opennews_widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/opennews_widget_section" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:text="Heute" android:maxLines="1" android:ellipsize="end"
            android:contentDescription="Widget einstellen" android:textSize="14sp" android:textColor="@color/widget_ink" />
        <TextView android:id="@+id/opennews_widget_forward" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="@color/widget_ink"
            android:contentDescription="Weitere Meldungen" android:visibility="gone" />
        <TextView android:id="@+id/opennews_widget_refresh" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:text="↻" android:textSize="20sp" android:textColor="@color/widget_ink"
            android:contentDescription="Meldungen aktualisieren" />
    </LinearLayout>
    <LinearLayout android:id="@+id/opennews_widget_lead" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingHorizontal="4dp" android:paddingVertical="3dp">
        <ImageView android:id="@+id/opennews_widget_image" android:layout_width="match_parent"
            android:layout_height="64dp" android:layout_marginBottom="5dp" android:scaleType="centerCrop"
            android:background="@drawable/opennews_widget_photo" android:clipToOutline="true"
            android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/opennews_widget_headlines" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
            android:text="OpenNews" android:textSize="16sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/opennews_widget_source" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textSize="12sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/opennews_widget_second" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingHorizontal="4dp" android:paddingVertical="3dp" android:visibility="gone">
        <TextView android:id="@+id/opennews_widget_next" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
            android:textSize="14sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/opennews_widget_next_source" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textSize="12sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/opennews_widget_third" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingHorizontal="4dp" android:paddingVertical="3dp" android:visibility="gone">
        <TextView android:id="@+id/opennews_widget_third_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
            android:textSize="14sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/opennews_widget_third_source" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textSize="12sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
</LinearLayout>
