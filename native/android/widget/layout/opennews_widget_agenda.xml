<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/opennews_widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:id="@+id/opennews_widget_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="20sp" android:textStyle="bold" android:text="Heute" android:maxLines="1"/>
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/opennews_widget_forward" android:layout_width="44dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="20sp" android:gravity="center" android:contentDescription="Weitere Meldungen"/>
        <TextView android:id="@+id/opennews_widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="20sp" android:gravity="center" android:contentDescription="OpenNews aktualisieren"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/opennews_widget_control" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/widget_tab_0" android:layout_width="0dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="12sp" android:layout_weight="1" android:gravity="center" android:text="Heute" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_tab_1" android:layout_width="0dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="12sp" android:layout_weight="1" android:gravity="center" android:text="Für dich" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_tab_2" android:layout_width="0dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="12sp" android:layout_weight="1" android:gravity="center" android:text="Neueste" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:id="@+id/opennews_widget_lead" android:layout_weight="1" android:background="@drawable/opennews_widget_control">
        <ImageView android:id="@+id/opennews_widget_image" android:layout_width="match_parent" android:layout_height="0dp" android:background="@drawable/opennews_widget_photo" android:clipToOutline="true" android:scaleType="centerCrop" android:importantForAccessibility="no" android:layout_weight="1"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="8dp" android:paddingVertical="4dp">
                <TextView android:id="@+id/widget_topic_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_topic" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/opennews_widget_headlines" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="17sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
                <TextView android:id="@+id/opennews_widget_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_save_0" android:layout_width="44dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="20sp" android:gravity="center" android:contentDescription="Artikel in OpenNews merken"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/opennews_widget_second" android:gravity="center_vertical" android:minHeight="48dp">
        <ImageView android:id="@+id/widget_thumb_1" android:layout_width="62dp" android:layout_height="44dp" android:background="@drawable/opennews_widget_photo" android:clipToOutline="true" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="8dp">
            <TextView android:id="@+id/widget_topic_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_topic" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/opennews_widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
            <TextView android:id="@+id/opennews_widget_next_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_save_1" android:layout_width="44dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="20sp" android:gravity="center" android:contentDescription="Artikel in OpenNews merken"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/opennews_widget_third" android:gravity="center_vertical" android:minHeight="48dp">
        <ImageView android:id="@+id/widget_thumb_2" android:layout_width="62dp" android:layout_height="44dp" android:background="@drawable/opennews_widget_photo" android:clipToOutline="true" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="8dp">
            <TextView android:id="@+id/widget_topic_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_topic" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/opennews_widget_third_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
            <TextView android:id="@+id/opennews_widget_third_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_save_2" android:layout_width="44dp" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="20sp" android:gravity="center" android:contentDescription="Artikel in OpenNews merken"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_discover" android:layout_width="match_parent" android:layout_height="44dp" android:textColor="@color/widget_ink" android:textSize="13sp" android:gravity="center" android:text="Weitere Themen entdecken  ›" android:textStyle="bold" android:background="@drawable/opennews_widget_control"/>
</LinearLayout>
