{
  "name": "opennews-website",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/content/*.test.ts src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
